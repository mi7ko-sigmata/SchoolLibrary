@{ ViewData["Title"] = "Вход"; }
<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">Вход</h1>
        @if (ViewData["Error"] is string e) { <div class="alert alert-danger">@e</div> }
        <form method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div class="mb-3"><label class="form-label">Потребителско име</label><input name="username" class="form-control" autofocus /></div>
            <div class="mb-3"><label class="form-label">Парола</label><input name="password" type="password" class="form-control" /></div>
            <button class="btn btn-primary">Вход</button>
        </form>
    </div>
</div>

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – Училищна библиотека</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Books" asp-action="Index">📚 Библиотека</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="Index">Каталог</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="My" asp-action="Index">Моите книги</a></li>
                        @if (User.IsInRole(Roles.Librarian))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Loans" asp-action="Borrow">Заемане</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Loans" asp-action="Index">Заемания</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Loans" asp-action="Overdue">Просрочени</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Readers" asp-action="Index">Читатели</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Loans" asp-action="History">История</a></li>
                        }
                    </ul>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center gap-2">
                        <span class="navbar-text">@User.Identity!.Name</span>
                        <button class="btn btn-outline-light btn-sm">Изход</button>
                    </form>
                }
            </div>
        </div>
    </nav>
    <main class="container pb-5">
        @if (TempData["Ok"] is string ok) { <div class="alert alert-success">@ok</div> }
        @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

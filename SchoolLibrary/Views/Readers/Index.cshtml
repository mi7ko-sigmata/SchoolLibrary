@model List<User>
@{
    ViewData["Title"] = "Читатели";
    var counts = (Dictionary<int, int>)ViewBag.ActiveCounts;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Читатели</h1>
    <a class="btn btn-primary" asp-action="Create">+ Нов читател</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Име или клас" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">Търси</button></div>
</form>
<div class="table-responsive">
<table class="table align-middle">
    <thead><tr><th>Име</th><th>Клас</th><th>Потр. име</th><th>Заети книги</th><th>Статус</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr class="@(r.IsActive ? "" : "text-muted")">
            <td>@r.FullName</td><td>@r.ClassName</td><td>@r.Username</td>
            <td>@(counts.TryGetValue(r.Id, out var n) ? n : 0)</td>
            <td>@(r.IsActive ? "активен" : "деактивиран")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-controller="Loans" asp-action="History" asp-route-readerId="@r.Id">История</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@r.Id">Редакция</a>
                @if (r.IsActive)
                {
                    <form asp-action="Deactivate" asp-route-id="@r.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger">Деактивирай</button></form>
                }
                else
                {
                    <form asp-action="Activate" asp-route-id="@r.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-success">Активирай</button></form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@model BookForm
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Нова книга" : "Редакция на книга";
}
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form method="post" asp-action="@(isNew ? "Create" : "Edit")">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="Author" class="form-label"></label><input asp-for="Author" class="form-control" /><span asp-validation-for="Author" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="Genre" class="form-label"></label><input asp-for="Genre" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Isbn" class="form-label"></label><input asp-for="Isbn" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Year" class="form-label"></label><input asp-for="Year" class="form-control" /><span asp-validation-for="Year" class="text-danger"></span></div>
        <div class="col-12 form-check ms-2"><input asp-for="ReadingRoomOnly" class="form-check-input" /><label asp-for="ReadingRoomOnly" class="form-check-label"></label></div>
        @if (isNew)
        {
            <div class="col-12"><label asp-for="InventoryNumbers" class="form-label"></label><textarea asp-for="InventoryNumbers" rows="3" class="form-control"></textarea><span asp-validation-for="InventoryNumbers" class="text-danger"></span></div>
        }
    </div>
    <div class="mt-3"><button class="btn btn-primary">Запази</button> <a class="btn btn-link" asp-action="Index">Отказ</a></div>
</form>
